/** S209: actual one-hour cache rendered in the real app; only names and opaque IDs are synthetic aliases. */
import {readFileSync,mkdirSync,writeFileSync} from 'node:fs';import {createHash} from 'node:crypto';import {join} from 'node:path';import {createServer} from 'node:net';import {setTimeout as pause} from 'node:timers/promises';
import {bootFixture,matrix,caseName} from '../smoke-fixture/index.mts';
const baseline=process.env.CAPTURE_PHASE==='before';const out=process.env.OUT,input=process.env.MEASUREMENT;if(!out||!input)throw Error('OUT and MEASUREMENT required');mkdirSync(out,{recursive:true});const measured=JSON.parse(readFileSync(input,'utf8'));if(measured.durationMs<3600000||measured.options.agent_footprint!==true||measured.options.enabled!==true)throw Error('Completed real one-hour BOTH measurement required');
if(measured.snapshot?.footprint?.reading?.covered!==1||measured.processSamples<59)throw Error('Validated owned-root footprint coverage required');
const health=structuredClone(measured.snapshot),aliases=new Map<string,string>();health.platformSupported=true;
for(const [i,volume]of(health.disks.value?.volumes??[]).entries()){const id=(i+100).toString(16).padStart(16,'0');aliases.set(volume.id,id);volume.id=id;delete volume.sharedGroup;}
for(const list of [health.alerts?.active,health.alerts?.resolved])for(const record of list??[])for(const [oldId,id]of aliases)if(record.key==='disk:'+oldId)record.key='disk:'+id;
if(health.footprint?.reading){for(const row of health.footprint.reading.rows)row.label='Sample helper';Object.assign(health.footprint.reading,{offset:0,hasMore:false});}
const answer=measured.historyAnswer;if(answer.ok)for(const series of answer.value.series)for(const [oldId,id]of aliases)series.id=series.id.replace(oldId,id);
const listener=createServer();await new Promise<void>((r,j)=>{listener.once('error',j);listener.listen(0,'127.0.0.1',r)});const port=(listener.address()as any).port;await new Promise<void>(r=>listener.close(()=>r()));if(port===65535)throw Error('No adjacent fixture port');
const fx=await bootFixture({port,roster:[{name:'sample-helper',displayName:'Sample helper',backend:'claude-code',description:'Synthetic capture identity',status:'stopped'}],classic:false,host:true});
if(baseline)delete health.footprint;
const {HostFootprint}=await import('../../../src/host-monitoring-footprint.js');const retained=new HostFootprint({roots:()=>[]});(retained as any).value=structuredClone(health.footprint);
fx.fm.fleetConfig.monitoring={enabled:true,agent_footprint:!baseline};fx.fm.rawFleetConfig.monitoring={...fx.fm.fleetConfig.monitoring};fx.fm.hostMonitoringAvailable=()=>true;fx.fm.hostHealthSnapshot=()=>({...structuredClone(health),...(baseline?{}:{footprint:retained.snapshot()})});fx.fm.hostHistoryQuery=async(_range:string,series:string[])=>answer.ok?{ok:true,value:{...answer.value,series:answer.value.series.filter((s:any)=>series.includes(s.id))}}:answer;
fx.fm.notifyFleetError=()=>{throw Error('No notification sender in capture fixture');};const checks:any[]=[];
async function take(name:string,c:any,path:string,selected=false){const {ctx,page}=await fx.page(c,{path});const errors:string[]=[],assets:any[]=[];page.on('response',async(response:any)=>{if(/\.(css|js)(\?|$)/.test(response.url()))try{assets.push({path:new URL(response.url()).pathname,sha256:createHash('sha256').update(await response.body()).digest('hex')});}catch{}});page.on('pageerror',(e:any)=>errors.push(String(e)));try{
 const selector=path.startsWith('/settings')?'#host-monitoring':baseline?'.host-health':'.host-footprint';await page.locator(selector).waitFor();await page.evaluate(()=>document.fonts.ready);if(selected&&!baseline)await page.locator('.host-footprint tbody button').first().click();await pause(250);
 const result=await page.locator(selector).evaluate((root:any)=>({overflow:document.documentElement.scrollWidth>innerWidth+1,rows:root.querySelectorAll('tbody tr').length,tableOverflow:[...root.querySelectorAll('.table-wrap')].some((el:any)=>el.scrollWidth>el.clientWidth+1),small:[...root.querySelectorAll('button,a.btn,input,select')].filter((el:any)=>{if(!el.offsetWidth||el.disabled)return false;let box=el.getBoundingClientRect();if(el.type==='checkbox')for(const label of el.labels||[]){const r=label.getBoundingClientRect();if(r.width>=44&&r.height>=44)return false;}return box.width<43.5||box.height<43.5;}).map((el:any)=>el.textContent||el.id),text:root.textContent}));
 if(result.overflow||(c.device==='phone'&&result.tableOverflow)||errors.length||(c.device==='phone'&&result.small.length)||/-t\d{5,}/.test(result.text))throw Error(JSON.stringify({name,result,errors}));
 if(path.startsWith('/settings')){await page.waitForFunction((before:boolean)=>{const inputs=[...document.querySelectorAll('#host-monitoring input[role=switch]')] as HTMLInputElement[];return inputs.length>=2&&inputs[0].checked&&(before||inputs[1].checked);},baseline,{timeout:10000});const states=await page.locator('#host-monitoring input[role=switch]').evaluateAll((inputs:any[])=>inputs.map(e=>e.checked));if(states.length<2||!states[0]||(!baseline&&!states[1]))throw Error('Both enabled settings must be visible');}
 const resourceUrls=await page.evaluate(()=>performance.getEntriesByType('resource').map((x:any)=>x.name).filter((url:string)=>/\.(css|js)(\?|$)/.test(url)));for(const url of resourceUrls){const response=await ctx.request.get(url);if(!response.ok())throw Error('Asset read failed');const path=new URL(url).pathname;if(!assets.some(a=>a.path===path))assets.push({path,sha256:createHash('sha256').update(await response.body()).digest('hex')});}
 if(!path.startsWith('/settings')){const text=await page.locator('.host-health').innerText();if(/[・]|採樣/.test(text))throw Error('Host terminology mismatch');if(!baseline&&await page.locator('.host-footprint-memory').evaluate((e:any)=>getComputedStyle(e).whiteSpace)!=='nowrap')throw Error('Memory header must stay together');}
 await page.screenshot({path:join(out,name+'.png'),fullPage:true});if(process.env.CAPTURE_POLISH&&c.device==='phone'&&c.lang==='zh-TW'&&!path.startsWith('/settings')){const alerts=page.locator('.host-alerts');const text=await alerts.innerText();if(!text.includes('目前沒有主機警示')||text.includes('標記已看過後')||text.includes('問題最後更新：'))throw Error('Empty alert view must omit explanation and absent update');await alerts.scrollIntoViewIfNeeded();await page.screenshot({path:join(out,name+'-alerts-empty.png')});}if(!baseline&&!path.startsWith('/settings')){await page.locator('.host-footprint').scrollIntoViewIfNeeded();await page.screenshot({path:join(out,name+'-footprint.png')});}
 delete result.text;checks.push({name,...c,path,assets,source:baseline?'actual-before-app-with-same-retained-host-cache':'actual-one-hour-host-cache-with-synthetic-identity-aliases',...result});
 }finally{await ctx.close();}}
try{for(const c of matrix(process.env.CAPTURE_MATRIX??'desk-light-en,phone-dark-zh-TW')){if(process.env.CAPTURE_VIEW!=='settings')await take((baseline?'before':'real')+'-health-'+caseName(c),c,'/ui/fleet/host-health',true);if(process.env.CAPTURE_VIEW!=='health'&&!(process.env.CAPTURE_POLISH&&c.lang==='en'))await take((baseline?'before':'real')+'-settings-'+caseName(c),c,'/settings/notifications#host-monitoring');}
 writeFileSync(join(out,'checks.json'),JSON.stringify({measurementDurationMs:measured.durationMs,processSamples:measured.processSamples,views:checks,scope:'Actual retained one-hour numerical cache and recorded history in real app. One owned idle process tree; labels/opaque disk IDs replaced with synthetic aliases. No fabricated native-agent workload, no notifications/accounts/models.'},null,2));
}finally{await fx.close();}
