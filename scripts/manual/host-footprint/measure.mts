/** One-hour real-host, isolated monitoring measurement. No Fleet/CLI/account/tmux start or recursive scan. */
import {mkdtempSync,readFileSync,writeFileSync,mkdirSync} from 'node:fs';import {tmpdir,cpus} from 'node:os';import {join} from 'node:path';import {spawn,execFileSync} from 'node:child_process';import {setTimeout as delay} from 'node:timers/promises';
import {HostFootprint} from '../../../src/host-monitoring-footprint.js';import {HostMonitoringRuntime} from '../../../src/host-monitoring-runtime.js';import {NativeHostMonitoring} from '../../../src/host-monitoring-platform.js';import {MemoryPressure} from '../../../src/memory-pressure.js';import {HostMonitoringHistory} from '../../../src/host-monitoring-history.js';import {HostMonitoringAlerts} from '../../../src/host-monitoring-alerts.js';import {defaultHostAlertSettings} from '../../../src/host-monitoring-alert-settings.js';
const out=process.env.OUT;if(!out)throw Error('OUT required');mkdirSync(out,{recursive:true});const duration=Number(process.env.MEASURE_MS??3600000);if(duration!==3600000)throw Error('The acceptance measurement is exactly one hour');
const scratch=mkdtempSync(join(tmpdir(),'agend-footprint-hour-')),file=join(scratch,'output.log');writeFileSync(file,'Synthetic managed output\n',{mode:0o600});
const helper=spawn(process.execPath,['-e','setInterval(()=>{},10000)'],{env:{PATH:'/usr/bin:/bin'},stdio:'ignore'});const helperClosed=new Promise<void>(r=>helper.once('close',()=>r()));await new Promise<void>((r,j)=>{helper.once('spawn',r);helper.once('error',j)});await delay(3000);
const hz=Number(execFileSync('/usr/bin/getconf',['CLK_TCK'],{encoding:'utf8',env:{PATH:'/usr/bin:/bin',LC_ALL:'C'}}).trim());
function counters(){const stat=readFileSync('/proc/self/stat','utf8').replace(/^.*\) /,'').split(' '),io=readFileSync('/proc/self/io','utf8');return{cpuUs:process.cpuUsage().user+process.cpuUsage().system,childrenCpuUs:(Number(stat[13])+Number(stat[14]))*1000000/hz,writeBytes:Number(/^write_bytes:\s*(\d+)/m.exec(io)![1]),rss:process.memoryUsage().rss,maxRss:process.resourceUsage().maxRSS*1024};}
const {FootprintAttribution}=await import('../../../src/host-monitoring-footprint-policy.js');
const nativeSample=FootprintAttribution.prototype.sample;
FootprintAttribution.prototype.sample=function(processes,roots,...args){const evidence=roots.map(root=>({observedAt:root.observedAt,wall:args[1],start:processes.find(p=>p.pid===root.pid)?.start,birth:processes.find(p=>p.pid===root.pid)?.birth,identity:processes.find(p=>p.pid===root.pid)?.identity,pinnedIdentity:(this as any).pins.get(root.id)?.identity}));const result=nativeSample.call(this,processes,roots,...args);console.log(JSON.stringify({stage:'root-evidence',evidence,covered:result.covered}));return result;};
let lost!:(reason:string)=>void;const failure=new Promise<string>(resolve=>lost=resolve);
const timerAbort=new AbortController(),stopRequested=()=>lost('Measurement stopped by operator');process.once('SIGTERM',stopRequested);process.once('SIGINT',stopRequested);
const observations:any[]=[];let runtime:HostMonitoringRuntime;const memory=new MemoryPressure();
const history=new HostMonitoringHistory({path:join(scratch,'host-monitoring.sqlite'),incidents:true,incidentReady:()=>alerts.ready(),unblocked:()=>runtime?.apply()});
const alerts=new HostMonitoringAlerts({persistence:history,changed(){},deliver(){throw Error('No real sender');}}),settings=defaultHostAlertSettings();
// Private local coordinator only: General disabled, no network delivery.
let helperObservedAt=Date.now();
let processSamples=0;const footprint=new HostFootprint({roots:()=>[{id:'a'.repeat(16),pid:helper.pid!,owner:'owned-measurement-helper',observedAt:helperObservedAt-1000,files:[file]}],changed:()=>{processSamples++;const covered=footprint.snapshot().reading?.covered;if(covered!==1)lost('Owned-root attribution lost; inspect root-evidence before another run');history.ingest(runtime.snapshot());}});
const config={enabled:true,agent_footprint:true};runtime=new HostMonitoringRuntime({history,footprint,supported:()=>true,committed:()=>config,raw:()=>({monitoring:config}),pin(){throw Error('Explicit booleans already supplied');},alerts:{configure:enabled=>alerts.configure(enabled,settings),stop:()=>alerts.stop(),ingest:s=>alerts.ingest(s),snapshot:()=>alerts.snapshot()},factory:()=>new NativeHostMonitoring({statePath:scratch,memory:()=>memory.snapshot()})});
let interval:ReturnType<typeof setInterval>|undefined;const start=performance.now(),before=counters();
try{
 memory.start();runtime.start();
 const readyUntil=Date.now()+5000;
 while(!footprint.snapshot().reading&&Date.now()<readyUntil)await delay(25);
 if(footprint.snapshot().reading?.covered!==1)throw Error('Initial owned-root attribution must be confirmed before waiting an hour');
 console.log(JSON.stringify({stage:'initial-root-confirmed',covered:1,options:config}));
 interval=setInterval(()=>{try{if(helper.exitCode!==null||helper.signalCode!==null)throw Error();process.kill(helper.pid!,0);helperObservedAt=Date.now();}catch{lost('Owned helper is no longer alive');}observations.push({at:Date.now(),...counters(),state:runtime.snapshot().state,footprint:footprint.snapshot().status,covered:footprint.snapshot().reading?.covered??0,history:history.status()});if(observations.length===60)console.log(JSON.stringify({stage:'30-minute-checkpoint',covered:footprint.snapshot().reading?.covered,history:history.status().state}));},30000);
 const failureReason=await Promise.race([delay(duration,undefined,{signal:timerAbort.signal}).then(()=>null),failure]);if(failureReason)throw Error(failureReason);clearInterval(interval);interval=undefined;
 const end=performance.now(),after=counters(),snapshot=runtime.snapshot(),series=[...new Set(['cpu.used','memory.available','memory.pressure','swap.free',...(snapshot.disks.value?.volumes.slice(0,8)??[]).flatMap(volume=>[`disk.${volume.id}.available`,`disk.${volume.id}.used`]),`agent.${'a'.repeat(16)}.cpu`,`agent.${'a'.repeat(16)}.rss`])],answer=await history.query('1h',series);
 const result={scope:'Actual host collectors, actual /bin/ps and SQLite/incident storage, one owned real idle process tree; no live Fleet agent attribution, no account, model, tmux or notifications. Process counters include sampler/history worker threads; reaped ps CPU separately measured; ps transient RSS not included in process peak.',durationMs:end-start,logicalCpus:cpus().length,options:config,processSamples,hostSamples:observations.length,before,after,cpuOneCorePercent:(after.cpuUs-before.cpuUs+after.childrenCpuUs-before.childrenCpuUs)/(end-start)/10,cpuTotalPercent:(after.cpuUs-before.cpuUs+after.childrenCpuUs-before.childrenCpuUs)/(end-start)/10/cpus().length,physicalWriteBytes:after.writeBytes-before.writeBytes,physicalWriteBytesPerHour:(after.writeBytes-before.writeBytes)*3600000/(end-start),peakRssBytes:Math.max(after.maxRss,...observations.map(s=>s.maxRss)),history:history.status(),snapshot,historyAnswer:answer,observations};
 writeFileSync(join(out,'measurement-private.json'),JSON.stringify(result,null,2),{mode:0o600});
 const {snapshot:_s,historyAnswer:_h,observations:_o,...publicSummary}=result;writeFileSync(join(out,'measurement-summary.json'),JSON.stringify(publicSummary,null,2));console.log(JSON.stringify(publicSummary));
}finally{timerAbort.abort();process.removeListener('SIGTERM',stopRequested);process.removeListener('SIGINT',stopRequested);if(interval)clearInterval(interval);runtime.stop();memory.stop();await footprint.stop();if(helper.exitCode===null&&helper.signalCode===null)helper.kill('SIGTERM');await helperClosed;const end=Date.now()+7000;while(history.status().state==='stopping'&&Date.now()<end)await delay(25);if(history.status().state==='stopping')throw Error('History did not physically stop');writeFileSync(join(out,'cleanup.json'),JSON.stringify({history:history.status().state,footprint:footprint.snapshot().status,helperClosed:true,scratchRetainedForEvidence:true}));}
