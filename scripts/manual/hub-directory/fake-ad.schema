# AD-shaped attributes for the fake directory, so the Hub's "ad" profile is tested end to end (an immutable binary
# objectGUID, the userAccountControl disable bit, sAMAccountName). TEST RIG ONLY: the OIDs sit under OpenLDAP's
# experimental arc (1.3.6.1.4.1.4203.666), which is reserved for experiments and never used by a real directory.
# A real Active Directory generates objectGUID itself; here the rig's tools set a random one when they create a user.

attributetype ( 1.3.6.1.4.1.4203.666.11.3095.1 NAME 'objectGUID'
	EQUALITY octetStringMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.4203.666.11.3095.2 NAME 'sAMAccountName'
	EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.4203.666.11.3095.3 NAME 'userPrincipalName'
	EQUALITY caseIgnoreMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.4203.666.11.3095.4 NAME 'userAccountControl'
	EQUALITY integerMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.4203.666.11.3095.5 NAME 'department'
	EQUALITY caseIgnoreMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.4203.666.11.3095.6 NAME 'accountExpires'
	EQUALITY integerMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )

objectclass ( 1.3.6.1.4.1.4203.666.11.3095.10 NAME 'fakeAdUser' AUXILIARY
	MUST ( objectGUID $ sAMAccountName $ userAccountControl )
	MAY ( userPrincipalName $ department $ accountExpires ) )

# So the "ad" profile's default filter, (&(objectClass=person)(!(objectClass=computer))), behaves as on AD: machine
# accounts are persons too there, and must never sign in as people.
objectclass ( 1.3.6.1.4.1.4203.666.11.3095.11 NAME 'computer' SUP inetOrgPerson STRUCTURAL )
