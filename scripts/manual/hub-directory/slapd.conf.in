# Generated into /run/rig by entrypoint.sh (@ADMIN_HASH@ and @READER_HASH@ are filled there). Test rig only.
include /etc/openldap/schema/core.schema
include /etc/openldap/schema/cosine.schema
include /etc/openldap/schema/inetorgperson.schema
include /rig/fake-ad.schema

modulepath /usr/lib/openldap
moduleload back_mdb.so
moduleload ppolicy.so
moduleload memberof.so
moduleload refint.so

pidfile  /run/rig/slapd.pid
argsfile /run/rig/slapd.args

TLSCACertificateFile  /run/rig/tls/ca.pem
TLSCertificateFile    /run/rig/tls/server.pem
TLSCertificateKeyFile /run/rig/tls/server.key
TLSProtocolMin 3.3

# Plain ldap:// on 1389 stays open ON PURPOSE: it would accept a plaintext bind. The Hub is LDAPS only and must never
# use it; the tests prove the refusal is the client's, not the server's.

database mdb
maxsize  33554432
suffix   "dc=example,dc=test"
rootdn   "cn=admin,dc=example,dc=test"
rootpw   @ADMIN_HASH@
directory /run/rig/data
index objectClass,uid,sAMAccountName eq
index entryUUID,objectGUID eq

overlay memberof
memberof-group-oc groupOfNames
memberof-member-ad member
memberof-memberof-ad memberOf
memberof-refint TRUE

overlay refint
refint_attributes member

overlay ppolicy
ppolicy_default "cn=default,ou=policies,dc=example,dc=test"

# The Hub reads with a service account; people may only bind (and change their own password).
access to attrs=userPassword
	by self =xw
	by anonymous auth
	by * none
access to *
	by dn.exact="cn=hub-reader,ou=service,dc=example,dc=test" read
	by self read
	by * none
