# Seed entries (filled by entrypoint.sh; every password is generated at start-up). Test rig only.
dn: dc=example,dc=test
objectClass: dcObject
objectClass: organization
dc: example
o: Example Test Directory

dn: ou=people,dc=example,dc=test
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=example,dc=test
objectClass: organizationalUnit
ou: groups

dn: ou=service,dc=example,dc=test
objectClass: organizationalUnit
ou: service

dn: ou=policies,dc=example,dc=test
objectClass: organizationalUnit
ou: policies

dn: cn=default,ou=policies,dc=example,dc=test
objectClass: device
objectClass: pwdPolicy
cn: default
pwdAttribute: userPassword
# Needed for the administrative lock (pwdAccountLockedTime 000001010000Z) to refuse a bind.
pwdLockout: TRUE

dn: cn=hub-reader,ou=service,dc=example,dc=test
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: hub-reader
userPassword: @READER_HASH@

# OpenLDAP-style people (identity = entryUUID, made by the server).
dn: uid=alice,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
uid: alice
cn: Alice Example
sn: Example
mail: alice@example.test
departmentNumber: Engineering
userPassword: @SEED_HASH@

# Disabled: an administrative ppolicy lock (the server also refuses her bind).
dn: uid=bob,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
uid: bob
cn: Bob Example
sn: Example
departmentNumber: Sales
pwdAccountLockedTime: 000001010000Z
userPassword: @SEED_HASH@

# Renamed: carol was carol.old before (scenario "rename" in README.md moves her back and forth).
dn: uid=carol,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
uid: carol
cn: Carol Example
sn: Example
departmentNumber: Engineering
userPassword: @SEED_HASH@

# Recreated: scenario "recreate" deletes dave and adds a new dave with the same login (a NEW entryUUID).
dn: uid=dave,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
uid: dave
cn: Dave Example
sn: Example
departmentNumber: Sales
userPassword: @SEED_HASH@

# AD-shaped people (identity = objectGUID, disabled = userAccountControl bit 2).
dn: cn=Erin Example,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
objectClass: fakeAdUser
cn: Erin Example
sn: Example
sAMAccountName: erin
userPrincipalName: erin@example.test
userAccountControl: 512
department: Engineering
objectGUID:: @ERIN_GUID@
userPassword: @SEED_HASH@

dn: cn=Frank Example,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
objectClass: fakeAdUser
cn: Frank Example
sn: Example
sAMAccountName: frank
userAccountControl: 514
department: Sales
objectGUID:: @FRANK_GUID@
userPassword: @SEED_HASH@

dn: cn=engineering,ou=groups,dc=example,dc=test
objectClass: groupOfNames
cn: engineering
member: uid=alice,ou=people,dc=example,dc=test
member: uid=carol,ou=people,dc=example,dc=test
member: cn=Erin Example,ou=people,dc=example,dc=test

dn: cn=sales,ou=groups,dc=example,dc=test
objectClass: groupOfNames
cn: sales
member: uid=bob,ou=people,dc=example,dc=test
member: uid=dave,ou=people,dc=example,dc=test
member: cn=Frank Example,ou=people,dc=example,dc=test
