/** Offline acceptance: REPO=$PWD OUT=<owned-dir> node --import tsx scripts/manual/grok-mcp-isolation/accept.mts */
import{mkdtempSync,mkdirSync,writeFileSync,readFileSync,rmSync}from'node:fs';import{join}from'node:path';import{tmpdir}from'node:os';import{createServer}from'node:net';import{spawnSync}from'node:child_process';
const R=process.env.REPO!,O=process.env.OUT!;mkdirSync(O,{recursive:true});const root=mkdtempSync(join(tmpdir(),'agend-grok-1411-'));const{GrokBackend}=await import(R+'/src/backend/grok.ts');const{shellQuote}=await import(R+'/src/backend/types.ts');const srv=createServer();await new Promise<void>((yes,no)=>{srv.once('error',no);srv.listen(join(root,'socket'),yes)});
const checks:any[]=[];const mcp=join(root,'owned-mcp.cjs'),fake=join(root,'fake-grok.cjs');
writeFileSync(mcp,'console.log(JSON.stringify({instance:process.env.AGEND_INSTANCE_NAME,toolSet:process.env.AGEND_TOOL_SET}));\n');
writeFileSync(fake,`const fs=require('node:fs'),p=require('node:path'),cp=require('node:child_process');const envFile=p.join(process.env.HOME,'fake-leader.json');if(!process.argv.includes('--no-leader')){if(fs.existsSync(envFile))Object.assign(process.env,JSON.parse(fs.readFileSync(envFile,'utf8')));else fs.writeFileSync(envFile,JSON.stringify({AGEND_GROK_MCP_DIR:process.env.AGEND_GROK_MCP_DIR,AGEND_GROK_MCP_BINDING:process.env.AGEND_GROK_MCP_BINDING}));}const c=JSON.parse(fs.readFileSync(p.join(process.cwd(),'.mcp.json'),'utf8'));const rows=Object.entries(c.mcpServers).map(([key,e])=>{const r=cp.spawnSync(e.command,e.args||[],{env:process.env,encoding:'utf8',timeout:2000});if(r.status!==0)throw Error('fixture MCP child failed '+r.stderr);return{key,...JSON.parse(r.stdout)}});console.log(JSON.stringify(rows));`);
function setup(name:string,cwd:string){const d=join(root,'instances',name);mkdirSync(d,{recursive:true});const b:any=new GrokBackend(d);b.binaryPath=shellQuote(process.execPath)+' '+shellQuote(fake);const c={workingDirectory:cwd,instanceDir:d,instanceName:name,mcpServers:{agend:{command:process.execPath,args:[mcp],env:{AGEND_SOCKET_PATH:join(root,'socket'),AGEND_TOOL_SET:name==='worker-b'?'reader':'developer'}}}};b.writeConfig(c);return{b,c};}
function launch(x:any){const r=spawnSync('/bin/sh',['-c',x.b.buildCommand(x.c)],{cwd:x.c.workingDirectory,env:{HOME:root,PATH:'/usr/bin:/bin',NODE_OPTIONS:process.env.NODE_OPTIONS,AGEND_TEST_GUARD_LOG:process.env.AGEND_TEST_GUARD_LOG},encoding:'utf8',timeout:4000});if(r.status!==0)throw Error('fake Grok failed '+r.stderr);return JSON.parse(r.stdout)}
try{const single=join(root,'single');mkdirSync(single);const s=setup('single-worker',single);const sr=launch(s);checks.push({name:'single-agent control',expected:['single-worker'],actual:sr,pass:sr.length===1&&sr[0].instance==='single-worker'});
const cwd=join(root,'shared');mkdirSync(cwd);const a=setup('worker-a',cwd),b=setup('worker-b',cwd);for(const x of[a,b]){const rows=launch(x);checks.push({name:'same-cwd '+x.c.instanceName+' only own identity/config',expected:[x.c.instanceName],actual:rows,pass:rows.length===1&&rows[0].instance===x.c.instanceName})}const bare=spawnSync(process.execPath,[fake],{cwd,env:{HOME:root,PATH:'/usr/bin:/bin'},encoding:'utf8',timeout:4000});checks.push({name:'env-less launch refuses tools',pass:bare.status!==0&&bare.stdout===''&&bare.stderr.includes('no tools loaded')});const out={source:process.env.SOURCE,scope:'production GrokBackend.writeConfig/buildCommand; fake Grok models project MCP discovery and actually executes only owned fixture wrappers; no real Grok/account/vendor',checks,cleanup:{privateSocketClosed:false,rootRemoved:false}};
await new Promise<void>(r=>srv.close(()=>r()));out.cleanup.privateSocketClosed=true;rmSync(root,{recursive:true,force:true});out.cleanup.rootRemoved=true;writeFileSync(join(O,'result.json'),JSON.stringify(out,null,2));console.log(JSON.stringify(out,null,2));if(checks.some(x=>!x.pass))process.exitCode=1;
}finally{if(srv.listening)await new Promise<void>(r=>srv.close(()=>r()));rmSync(root,{recursive:true,force:true})}
