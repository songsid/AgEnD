#!/bin/sh
# #1450: the `agend` and `agend-agent` npm bins (this file and launcher/agend-agent are identical). POSIX sh, so AgEnD
# starts with no Node on PATH at all: it execs this release's bundled Node on the JS launcher, which is the one place
# that decides and verifies the interpreter (launcher/runtime-select.cjs). A `node` on PATH is used only when the
# bundled Node is not installed; the JS launcher then decides whether that Node qualifies. Native Windows is not
# supported (WSL is), as with tmux.

# This file's real location: npm's global bin is a symlink, possibly relative, possibly to another link. A readlink
# loop, not `readlink -f` (older macOS lacks it; GNU is not assumed).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self") || break
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd -P) || exit 1
pkg=$(dirname "$dir")
launcher=$dir/$(basename "$self").cjs

case $(uname -s) in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  *) os=unsupported ;;
esac
case $(uname -m) in
  x86_64 | amd64) cpu=x64 ;;
  aarch64 | arm64) cpu=arm64 ;;
  *) cpu=unsupported ;;
esac
node=$pkg/node_modules/@songsid/agend-node-$os-$cpu/bin/node
receipt=$pkg/.agend-runtime.json
repair="npm install -g @songsid/agend"
refuse() { echo "AgEnD cannot start: $1." >&2; echo "To repair: $2" >&2; exit "${3:-1}"; }

# 1. AGEND_NODE, the operator's explicit choice: absolute and executable, then it runs the JS launcher, whose probe
#    refuses one that does not qualify. Never a silent fallback to another Node.
if [ -n "${AGEND_NODE:-}" ]; then
  case $AGEND_NODE in
    /*) ;;
    *) refuse "AGEND_NODE must be an absolute path (got $AGEND_NODE)" "unset AGEND_NODE, or point it at a Node 22.14+" ;;
  esac
  [ -f "$AGEND_NODE" ] && [ -x "$AGEND_NODE" ] || refuse "AGEND_NODE ($AGEND_NODE) is not an executable file" "unset AGEND_NODE, or point it at a Node 22.14+"
  exec "$AGEND_NODE" "$launcher" "$@"
fi

# 2. The bundled Node, only while it is still exactly what the postinstall verified: the receipt names this very file
#    and its size, and the file is not newer than the receipt. (The JS launcher checks the receipt again, fully.)
if [ -f "$receipt" ] && [ -f "$node" ] && [ ! -L "$node" ] && [ -x "$node" ]; then
  want_path=$(sed -n 's/^  "nodePath": "\(.*\)",$/\1/p' "$receipt")
  want_size=$(sed -n 's/^  "size": \([0-9][0-9]*\),$/\1/p' "$receipt")
  size=$(wc -c < "$node" | tr -d ' ')
  if [ "$want_path" = "$node" ] && [ "$want_size" = "$size" ] && [ -z "$(find "$node" -newer "$receipt" 2>/dev/null)" ]; then
    exec "$node" "$launcher" "$@"
  fi
fi

# 3. Not admitted here, so that candidate never runs. A node on PATH runs the JS launcher: it explains a refusal, or
#    is itself the choice when the runtime was skipped altogether (and it qualifies).
if command -v node >/dev/null 2>&1; then
  exec node "$launcher" "$@"
fi
if [ -e "$receipt" ] || [ -e "$node" ] || [ -L "$node" ]; then
  refuse "its bundled Node ($node) is missing, incomplete or changed since it was verified, and there is no node on PATH" "$repair"
fi
refuse "its bundled Node is not installed and there is no node on PATH" "$repair" 127
