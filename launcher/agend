#!/bin/sh
# #1450: the `agend` and `agend-agent` npm bins (this file and launcher/agend-agent are identical). POSIX sh, so AgEnD
# starts with no Node on PATH at all: it execs this release's bundled Node on the JS launcher, which is the one place
# that decides and verifies the interpreter (launcher/runtime-select.cjs). A `node` on PATH is used only when the
# bundled Node is not installed; the JS launcher then decides whether that Node qualifies. Native Windows is not
# supported (WSL is), as with tmux.

# This file's real location: npm's global bin is a symlink, possibly relative, possibly to another link. A readlink
# loop, not `readlink -f` (older macOS lacks it; GNU is not assumed).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self") || break
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd -P) || exit 1
pkg=$(dirname "$dir")
launcher=$dir/$(basename "$self").cjs

case $(uname -s) in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  *) os=unsupported ;;
esac
case $(uname -m) in
  x86_64 | amd64) cpu=x64 ;;
  aarch64 | arm64) cpu=arm64 ;;
  *) cpu=unsupported ;;
esac
node_pkg=$pkg/node_modules/@songsid/agend-node-$os-$cpu
node=$node_pkg/bin/node
receipt=$pkg/.agend-runtime.json
repair="npm install -g @songsid/agend"
refuse() { echo "AgEnD cannot start: $1." >&2; echo "To repair: $2" >&2; exit "${3:-1}"; }

# 1. AGEND_NODE, the operator's explicit choice: absolute and executable, then it runs the JS launcher, whose probe
#    refuses one that does not qualify. Never a silent fallback to another Node.
if [ -n "${AGEND_NODE:-}" ]; then
  case $AGEND_NODE in
    /*) ;;
    *) refuse "AGEND_NODE must be an absolute path (got $AGEND_NODE)" "unset AGEND_NODE, or point it at a Node 22.14+" ;;
  esac
  [ -f "$AGEND_NODE" ] && [ -x "$AGEND_NODE" ] || refuse "AGEND_NODE ($AGEND_NODE) is not an executable file" "unset AGEND_NODE, or point it at a Node 22.14+"
  exec "$AGEND_NODE" "$launcher" "$@"
fi

# 2. The bundled Node, only when it is admissible by the SAME contract the JS launcher applies
#    (launcher/runtime-select.cjs, "THE RECEIPT CONTRACT"), checked before anything runs:
#    - this release pins it (package.json), and the runtime package is that version;
#    - the receipt is exactly the contract's form, for that pin;
#    - the file is a regular file at the receipted realpath, with the receipted size and mtime (whole seconds).
#    A receipt in any other shape, or a candidate that differs in any of these, is never executed here.
admissible() {
  pin=$(sed -n "s/^    \"@songsid\/agend-node-$os-$cpu\": \"\([0-9][0-9.]*\(-agend\.[0-9][0-9]*\)\{0,1\}\)\",\{0,1\}\$/\1/p" "$pkg/package.json" | head -n 1)
  [ -n "$pin" ] || return 1
  version=$(sed -n 's/^  "version": "\([^"]*\)",\{0,1\}$/\1/p' "$node_pkg/package.json" | head -n 1)
  [ "$version" = "$pin" ] || return 1
  [ -f "$receipt" ] && [ -f "$node" ] && [ ! -L "$node" ] && [ -x "$node" ] || return 1
  [ "$(wc -l < "$receipt" | tr -d ' ')" = 13 ] || return 1
  [ "$(sed -n 1p "$receipt")" = "{" ] && [ "$(sed -n 2p "$receipt")" = '  "receipt": 2,' ] && [ "$(sed -n 13p "$receipt")" = "}" ] || return 1
  r_pin=$(sed -n '3s/^  "pinnedVersion": "\([0-9][0-9.]*\(-agend\.[0-9][0-9]*\)\{0,1\}\)",$/\1/p' "$receipt")
  r_path=$(sed -n '4s/^  "nodePath": "\(\/[^"\\]*\)",$/\1/p' "$receipt")
  r_size=$(sed -n '5s/^  "size": \([0-9][0-9]*\),$/\1/p' "$receipt")
  r_mtime=$(sed -n '6s/^  "mtime": \([0-9][0-9]*\),$/\1/p' "$receipt")
  # ERE (grep -E) for alternation: BSD sed's basic regexes have none.
  sed -n 7p "$receipt" | grep -Eq '^  "sha256": "[0-9a-f]{64}",$' || return 1
  sed -n 8p "$receipt" | grep -Eq '^  "napi": (0|[1-9][0-9]*),$' || return 1
  sed -n 9p "$receipt" | grep -Eq '^  "platform": "[^"\\]+",$' || return 1
  sed -n 10p "$receipt" | grep -Eq '^  "arch": "[^"\\]+",$' || return 1
  sed -n 11p "$receipt" | grep -Eq '^  "libc": ("glibc"|null),$' || return 1
  sed -n 12p "$receipt" | grep -Eq '^  "verifiedAt": "[^"\\]+"$' || return 1
  [ -n "$r_pin" ] && [ -n "$r_path" ] && [ -n "$r_size" ] && [ -n "$r_mtime" ] || return 1
  # (A leading-zero size/mtime, which JSON forbids, can never equal what wc and stat print below.)
  [ "$r_pin" = "$pin" ] || return 1
  [ "$(cd "$(dirname "$node")" 2>/dev/null && pwd -P)/node" = "$r_path" ] || return 1
  [ "$(wc -c < "$node" | tr -d ' ')" = "$r_size" ] || return 1
  mtime=$(stat -c %Y "$node" 2>/dev/null) || mtime=$(stat -f %m "$node" 2>/dev/null) || return 1
  [ "$mtime" = "$r_mtime" ]
}
if admissible; then
  exec "$node" "$launcher" "$@"
fi

# 3. Not admitted here, so that candidate never runs. A node on PATH runs the JS launcher: it explains a refusal, or
#    is itself the choice when the runtime was skipped altogether (and it qualifies).
if command -v node >/dev/null 2>&1; then
  exec node "$launcher" "$@"
fi
if [ -e "$receipt" ] || [ -e "$node" ] || [ -L "$node" ]; then
  refuse "its bundled Node ($node) is missing, incomplete or changed since it was verified, and there is no node on PATH" "$repair"
fi
refuse "its bundled Node is not installed and there is no node on PATH" "$repair" 127
