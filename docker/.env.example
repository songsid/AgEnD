# Copy to docker/.env and edit. Read on first start (fleet.yaml is written once from it) and on every start (tokens).

# The first instance: its name and backend (claude-code, codex, kiro-cli, grok, opencode, antigravity, muse).
AGEND_INSTANCE=dev
AGEND_BACKEND=claude-code

# Pin CLI versions where the installer takes one (claude-code, kiro-cli); others install the newest.
# AGEND_CLI_VERSIONS=claude-code=2.1.300,kiro-cli=2.34.0

# Optional chat platform (else the fleet is web-only): telegram or discord, the group/guild id, your user id(s).
# AGEND_CHANNEL=telegram
# AGEND_GROUP_ID=-1001234567890
# AGEND_ADMIN_IDS=123456789
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# API keys, if you sign the CLIs in with a key instead of /login:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
