#!/bin/sh
# AgEnD container entrypoint (#581), run by tini. With arguments it runs them (`docker compose run --rm agend agend
# doctor`); without, it prepares the home volume and becomes the fleet.
set -u
if [ "$#" -gt 0 ]; then exec "$@"; fi

home="${HOME:-/home/agend}"
data="${AGEND_HOME:-$home/.agend}"
uid="$(id -u)"
# AgEnD keeps its data in a directory it owns (0700); a volume or bind mount owned by another uid cannot hold it.
if [ ! -w "$home" ] || [ "$(stat -c %u "$home")" != "$uid" ]; then
  echo "agend-container: $home must be owned and writable by uid $uid. Fix it once from the host:" >&2
  echo "  docker compose run --rm --user root --entrypoint chown agend -R $uid:$(id -g) $home" >&2
  exit 78
fi
mkdir -p "$data" && chmod 700 "$data" || exit 78

agend container prepare || { echo "agend-container: the fleet cannot start (see above)" >&2; exit 78; }
exec agend fleet start
