import{mkdirSync,writeFileSync}from'node:fs';import{join}from'node:path';const R=process.env.REPO!,O=process.env.OUT!;mkdirSync(O,{recursive:true});const{bootFixture,matrix,caseName,VIEWPORTS}=await import(R+'/scripts/manual/smoke-fixture/index.mts');const fx=await bootFixture({port:48334,instances:2,classic:false,host:true});const{base32Encode,WEB_REMOTE_ACCESS_FILE}=await import(R+'/src/web-remote-access.ts');
const checks:any[]=[];const check=(name:string,ok:boolean)=>{checks.push({name,ok});console.log(ok?'PASS':'FAIL',name);};
try{for(const c of matrix())for(const mode of ['typed6','extend8','paste6']){
 fx.fm.webRemoteAccessState?.close();writeFileSync(join(fx.dir,WEB_REMOTE_ACCESS_FILE),JSON.stringify({v:1,totp:{secret:base32Encode(Buffer.from('owned-a12-timing-secret')),enrolledAt:1,lastStep:0},outside:false,wrong:0,level:0,pausedUntil:0}),{mode:0o600});fx.fm.webRemoteAccessState=undefined;
 const ctx=await fx.browser.newContext({viewport:VIEWPORTS[c.device],locale:'zh-TW',colorScheme:c.theme,isMobile:c.device==='phone',hasTouch:c.device==='phone'}),page=await ctx.newPage();page.setDefaultTimeout(10000);await page.goto(fx.base+'/signin');await page.locator('#code').waitFor();const clockStart=Date.now();await page.clock.install({time:clockStart});await page.clock.pauseAt(new Date(clockStart+1000));const posts:string[]=[];page.on('request',(r:any)=>{if(r.method()==='POST')posts.push(new URL(r.url()).pathname)});
 const input=async(v:string,paste=false)=>page.locator('#code').evaluate((el:any,arg:any)=>{el.value=arg.v;el.dispatchEvent(new InputEvent('input',{bubbles:true,inputType:arg.paste?'insertFromPaste':'insertText'}))},{v,paste});
 const cn=caseName(c)+'-'+mode;
 const response=page.waitForResponse((r:any)=>r.url().endsWith(mode==='extend8'?'/auth/login':'/auth/totp'));await input('234567',mode==='paste6');
 if(mode==='paste6'){await response;check(cn+':immediate-totp',posts.join()==='/auth/totp');}
 else{await page.clock.runFor(799);check(cn+':nothing-at799',posts.length===0);if(mode==='extend8'){await input('234567AB');await response;await page.clock.runFor(1000);console.log('AUTH_PATHS',cn,JSON.stringify(posts));check(cn+':8-cancels6',posts.join()==='/auth/login');}else{await page.clock.runFor(1);await response;check(cn+':totp-at800',posts.join()==='/auth/totp');}}
 await page.screenshot({path:join(O,cn+'.png')});await ctx.close();
}}catch(e){console.error(e);checks.push({name:'exception',ok:false,detail:String(e)});process.exitCode=1;}finally{await fx.close();writeFileSync(join(O,'result.json'),JSON.stringify({checks,scope:'real browser clock injected; actual HTTP wrong-code routes; no API response stub; all credentials synthetic'},null,2));if(checks.some(x=>!x.ok))process.exitCode=1;}
