{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "snapshot": false,
  "share": "disabled",
  "enabled_providers": [
    "mock"
  ],
  "model": "mock/probe-reasoning",
  "small_model": "mock/probe-reasoning",
  "provider": {
    "mock": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local audit mock",
      "options": {
        "baseURL": "http://127.0.0.1:18801/v1",
        "apiKey": "audit-placeholder"
      },
      "models": {
        "probe-reasoning": {
          "name": "Probe reasoning",
          "reasoning": true,
          "limit": {
            "context": 32000,
            "output": 1024
          }
        },
        "probe-plain": {
          "name": "Probe plain",
          "reasoning": false,
          "limit": {
            "context": 32000,
            "output": 1024
          }
        }
      }
    }
  }
}