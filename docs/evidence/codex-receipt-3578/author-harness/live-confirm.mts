import {createHash} from 'node:crypto';
import {execFileSync} from 'node:child_process';import{writeFileSync,readFileSync}from'node:fs';import{join}from'node:path';
const [repo,root,sock,target,backendName,scenario]=process.argv.slice(2);const sourceHash=()=>createHash('sha256').update(readFileSync(repo+'/src/daemon.ts')).digest('hex');const sourceBefore=sourceHash();const {Daemon}=await import(repo+'/src/daemon.ts');const {CodexBackend}=await import(repo+'/src/backend/codex.ts');const {ClaudeCodeBackend}=await import(repo+'/src/backend/claude-code.ts');const {TmuxControlClient}=await import(repo+'/src/tmux-control.ts');
const T=(...a:string[])=>execFileSync('/usr/bin/tmux',['-f','/dev/null','-S',sock,...a],{encoding:'utf8'});const cap=()=>T('capture-pane','-p','-t',target);const backend=backendName==='codex'?new CodexBackend(root):new ClaudeCodeBackend(root);const log:any={info(){},warn(){},debug(){},error(){},child(){return this}};
const d:any=new Daemon('owned',{working_directory:root,backend:backendName,log_level:'silent',restart_policy:{max_retries:0,backoff:'linear',reset_after:0},context_guardian:{grace_period_ms:600000,max_age_hours:0}},root,false,backend,undefined,log);let writes=0;let captures=0;
const send=async()=>{writes++;T('send-keys','-t',target,'Enter');return true};d.tmux={getWindowId:()=>target,capturePane:async()=>{captures++;return cap()}};d.sendDeliveryEnter=send;
const control:any={stopped:false,logger:log,isIdle:()=>!backend.getBusyPattern?.()?.test(cap())};control.waitUntilIdle=(...a:any[])=>(TmuxControlClient.prototype.waitUntilIdle as any).apply(control,a);d.controlClient=control;
const id='m3578-'+backendName+'-'+scenario;const text='[from:offline-test] Confirm this mock-only message.\n(message_id: '+id+')';const signature={value:'message_id:'+id,unique:true};const baseline=await d.capturePaneEvidence(signature);writeFileSync(join(root,scenario+'-before.pane.txt'),cap());writeFileSync(join(root,'payload.txt'),text);T('load-buffer','-b','owned',join(root,'payload.txt'));T('paste-buffer','-p','-b','owned','-t',target);await new Promise(r=>setTimeout(r,150));const at=Date.now();await send();const trace:any[]=[];const judge=d.judgeSubmission.bind(d);d.judgeSubmission=(...a:any[])=>{const v=judge(...a);trace.push({afterEnterMs:Date.now()-at,verdict:v});return v};
const confirmed=await d.confirmAfterEnter(target,at,signature,baseline,'live-retry');writeFileSync(join(root,scenario+'-after.pane.txt'),cap());if(sourceHash()!==sourceBefore)throw Error('Source changed during acceptance');const result={sourceSha256:sourceBefore,backend:backendName,scenario,confirmed,elapsedMs:Date.now()-at,enters:writes,captures,trace,scope:'real audited CLI/live mock APIs; production confirmAfterEnter+judge/readiness; manual private tmux paste/Enter (not a full fleet/outbox journey)'};writeFileSync(join(root,scenario+'-result.json'),JSON.stringify(result,null,2));console.log(JSON.stringify(result));if(!confirmed||writes!==1)process.exit(1);
