=== 5. Why agend update and install.sh set the variable: through npm exec, only the variable reaches the installer
npm 10.9.7, variable:
  installer sees npm_config_allow_scripts=@songsid/agend
npm 10.9.7, flag:
  installer sees npm_config_allow_scripts=@songsid/agend
npm 11.21.3, variable:
  installer sees npm_config_allow_scripts=@songsid/agend
npm 11.21.3, flag:
  installer sees npm_config_allow_scripts=undefined
npm 12.2.3, variable:
  installer sees npm_config_allow_scripts=@songsid/agend
npm 12.2.3, flag:
  installer sees npm_config_allow_scripts=undefined

