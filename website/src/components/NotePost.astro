---
// One Engineering Notes post: its date, title, summary and tags above the Markdown body.
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/utils';
import { t } from '../i18n/utils';
import { notePath, noteSlug, formatNoteDate } from '../i18n/notes';

interface Props { locale: Locale; post: CollectionEntry<'notes'> }
const { locale, post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(post);
---

<article class="mx-auto max-w-3xl px-6 pt-28 pb-16">
  <a href={notePath(base, locale)} class="text-sm text-text-secondary hover:text-text-primary transition-colors">{t(locale, 'notes.back')}</a>
  <header class="mt-4 mb-10">
    <time datetime={post.data.date.toISOString().slice(0, 10)} class="text-xs font-mono text-text-secondary">{formatNoteDate(post.data.date)}</time>
    <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-text-primary">{post.data.title}</h1>
    <p class="mt-4 text-lg text-text-secondary leading-relaxed">{post.data.summary}</p>
    {post.data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => <li class="text-xs font-mono text-accent bg-accent-dim rounded px-2 py-0.5">{tag}</li>)}
      </ul>
    )}
  </header>
  <div class="note-body">
    <Content />
  </div>
  <p class="mt-12"><a href={notePath(base, locale)} class="text-sm text-text-secondary hover:text-text-primary transition-colors">{t(locale, 'notes.back')}</a></p>
</article>

<style is:global>
  .note-body { color: var(--color-text-secondary); line-height: 1.75; overflow-wrap: anywhere; }
  .note-body > * + * { margin-top: 1.1em; }
  .note-body h2 { margin-top: 2.2em; font-size: 1.5rem; font-weight: 700; color: var(--color-text-primary); }
  .note-body h3 { margin-top: 1.8em; font-size: 1.15rem; font-weight: 700; color: var(--color-text-primary); }
  .note-body strong { color: var(--color-text-primary); }
  .note-body a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
  .note-body ul { list-style: disc; padding-left: 1.4em; }
  .note-body ol { list-style: decimal; padding-left: 1.4em; }
  .note-body li + li { margin-top: 0.35em; }
  .note-body code { font-family: var(--font-family-mono); font-size: 0.9em; color: var(--color-text-primary); background: var(--color-raised); border-radius: 4px; padding: 0.1em 0.35em; }
  .note-body pre { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: 1em; overflow-x: auto; }
  .note-body pre code { background: none; padding: 0; }
  .note-body blockquote { border-left: 3px solid var(--color-accent); padding-left: 1em; color: var(--color-text-secondary); }
  .note-body table { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 0.95em; }
  .note-body th, .note-body td { border: 1px solid var(--color-border); padding: 0.5em 0.75em; text-align: left; white-space: nowrap; }
  .note-body th { color: var(--color-text-primary); background: var(--color-surface); }
</style>
