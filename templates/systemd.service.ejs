[Unit]
Description=AgEnD — AI Engineering Daemon
After=network.target
# Stop retrying after 4 failed starts in 30 minutes (#1113). A fleet start takes
# minutes, so the default 5-in-10s limit could never trip: under host memory
# exhaustion the watchdog killed and systemd restarted the fleet indefinitely,
# each restart respawning every CLI into the same pressure. `agend restart`
# clears the counter (reset-failed) before it restarts.
StartLimitIntervalSec=30min
StartLimitBurst=4

[Service]
Type=notify
# NotifyAccess must stay "all": sdNotify() delivers via a short-lived
# systemd-notify child, so "main"/"exec" reject it with
# "Got notification message from PID <helper>, but reception only permitted
# for main PID <service>" (Result=protocol), breaking READY/WATCHDOG.
# The capability is instead contained in src/sd-notify.ts, which removes
# NOTIFY_SOCKET from the environment so no other child process inherits it.
NotifyAccess=all
# READY=1 is sent once every instance has started (minutes on a large fleet).
# Bounded so a start that hangs before READY is noticed (#1113).
TimeoutStartSec=15min
WatchdogSec=60
ExecStart=<%- program.map(systemdQuote).join(" ") %> fleet start
Environment=PATH=<%= path %>
Environment=TERM=xterm-256color
<% if (isRoot) { %>Environment=IS_SANDBOX=1
<% } %>WorkingDirectory=<%= workingDirectory %>
Restart=on-failure
RestartSec=5
# Daemon shutdown is bounded per batch; do not let an uncooperative backend
# hold systemctl stop/update for the previous five-minute default.
TimeoutStopSec=60
# Stop by signalling the fleet process only (#908). The tmux server and every
# CLI inside it live in this unit's cgroup, and the default control-group mode
# SIGTERMs all of them at once: kiro-cli aborted (SIGABRT, a ~1 GB core dump on
# WSL) before the fleet could quit it gracefully, and the tmux server went with
# it. With mixed, the fleet stops each CLI itself; only what is still left after
# TimeoutStopSec is SIGKILLed.
KillMode=mixed
# No multi-GB core dumps (#1113). On WSL core_pattern pipes every crash to
# /wsl-capture-crash, and a piped core_pattern ignores RLIMIT_CORE, so
# LimitCORE=0 alone does not stop them. A zero coredump_filter writes no memory
# mappings (a ~32 KB dump instead of 1 GB), and it is inherited by the tmux
# server and every CLI the fleet starts. LimitCORE=0 covers a file core_pattern.
CoredumpFilter=0
LimitCORE=0
StandardOutput=append:<%= logPath %>
StandardError=append:<%= logPath %>

[Install]
WantedBy=default.target
