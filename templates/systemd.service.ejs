[Unit]
Description=AgEnD — AI Engineering Daemon
After=network.target

[Service]
Type=notify
# NotifyAccess must stay "all": sdNotify() delivers via a short-lived
# systemd-notify child, so "main"/"exec" reject it with
# "Got notification message from PID <helper>, but reception only permitted
# for main PID <service>" (Result=protocol), breaking READY/WATCHDOG.
# The capability is instead contained in src/sd-notify.ts, which removes
# NOTIFY_SOCKET from the environment so no other child process inherits it.
NotifyAccess=all
TimeoutStartSec=0
WatchdogSec=60
ExecStart=<%= execPath %> fleet start
Environment=PATH=<%= path %>
Environment=TERM=xterm-256color
<% if (isRoot) { %>Environment=IS_SANDBOX=1
<% } %>WorkingDirectory=<%= workingDirectory %>
Restart=on-failure
RestartSec=5
# Daemon shutdown is bounded per batch; do not let an uncooperative backend
# hold systemctl stop/update for the previous five-minute default.
TimeoutStopSec=60
# Stop by signalling the fleet process only (#908). The tmux server and every
# CLI inside it live in this unit's cgroup, and the default control-group mode
# SIGTERMs all of them at once: kiro-cli aborted (SIGABRT, a ~1 GB core dump on
# WSL) before the fleet could quit it gracefully, and the tmux server went with
# it. With mixed, the fleet stops each CLI itself; only what is still left after
# TimeoutStopSec is SIGKILLed.
KillMode=mixed
StandardOutput=append:<%= logPath %>
StandardError=append:<%= logPath %>

[Install]
WantedBy=default.target
