[Unit]
Description=AgEnD — AI Engineering Daemon
After=network.target

[Service]
Type=notify
# Node delegates AF_UNIX datagram sends to systemd-notify, so the helper must
# be accepted. src/sd-notify.ts keeps NOTIFY_SOCKET out of all other children.
NotifyAccess=all
TimeoutStartSec=0
WatchdogSec=60
ExecStart=<%= execPath %> fleet start
Environment=PATH=<%= path %>
Environment=TERM=xterm-256color
<% if (isRoot) { %>Environment=IS_SANDBOX=1
<% } %>WorkingDirectory=<%= workingDirectory %>
Restart=on-failure
RestartSec=5
# Daemon shutdown is bounded per batch; do not let an uncooperative backend
# hold systemctl stop/update for the previous five-minute default.
TimeoutStopSec=60
StandardOutput=append:<%= logPath %>
StandardError=append:<%= logPath %>

[Install]
WantedBy=default.target
